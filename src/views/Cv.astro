---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { jobs, skills, certifications, education, languages } from '../data/cv';

const t = {
  title: 'CV',
  description: 'Résumé of Iván Guirola: IAM experience at KPMG and Accenture, certifications and skills.',
  lead: 'Identity and access (IAM) architecture and management. Barcelona.',
  print: 'Save as PDF',
  experience: 'Experience',
  skills: 'Skills',
  certs: 'Certifications',
  education: 'Education',
  languages: 'Languages',
  present: 'Present',
};

const fmt = new Intl.DateTimeFormat('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const month = (ym: string | null) => (ym ? fmt.format(new Date(`${ym}-01T00:00:00Z`)) : t.present);
---

<Base page="cv" title={t.title} description={t.description}>
  <header class="page-head">
    <h1>{site.name}</h1>
    <p>{t.lead}</p>
    <div class="actions no-print">
      <button class="btn" type="button" data-print>{t.print}</button>
    </div>
  </header>

  <section class="section">
    <h2>{t.experience}</h2>
    <ol class="timeline">
      {
        jobs.map((job) => (
          <li>
            <div>
              <time datetime={job.start}>{month(job.start)}</time> –{' '}
              {job.end ? <time datetime={job.end}>{month(job.end)}</time> : t.present}
            </div>
            <div>
              <h3>{job.role}</h3>
              <div class="org">
                {job.company}, {job.place}
              </div>
              {job.points && (
                <ul>
                  {job.points.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section">
    <h2>{t.skills}</h2>
    <dl class="skills">
      {
        skills.map((s) => (
          <div>
            <dt>{s.group}</dt>
            <dd>{s.items.join(', ')}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="section">
    <h2>{t.certs}</h2>
    <ul class="pairs">
      {
        certifications.map((c) => (
          <li>
            <strong>
              <img class="logo" src={`/logos/${c.logo}`} alt="" width="28" height="28" loading="lazy" />
              {c.name}
            </strong>
            <span>{c.issuer}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section">
    <h2>{t.education}</h2>
    <ul class="pairs">
      <li>
        <strong>{education.title}</strong>
        <span>{education.school}, {education.years}</span>
      </li>
    </ul>
  </section>

  <section class="section">
    <h2>{t.languages}</h2>
    <ul class="pairs">
      {
        languages.map((l) => (
          <li>
            <strong>{l.name}</strong>
            <span>{l.level}</span>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>
