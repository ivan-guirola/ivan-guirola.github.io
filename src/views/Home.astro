---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Token from '../components/Token.astro';
import Preview from '../components/Preview.astro';
import { routes } from '../data/nav';
import { certifications } from '../data/cv';
import { categoryLabels } from '../data/categories';
import { site } from '../data/site';

const photo = Object.values(
  import.meta.glob<{ default: ImageMetadata }>('../assets/profile.{jpg,jpeg,png,webp}', { eager: true }),
)[0]?.default;

const iamStart = new Date('2021-01-01T00:00:00Z');
const years = Math.floor((Date.now() - iamStart.getTime()) / (365.25 * 24 * 3600 * 1000));
const yearWords = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'];

const t = {
  description:
    'Iván Guirola, identity and access (IAM) architecture specialist based in Barcelona: design of authentication, federation and identity governance solutions with OAuth 2.0, OIDC, SAML and SCIM.',
  h1: 'Iván Guirola Ullate',
  lead: `Identity and access management (IAM) architect based in Barcelona, with more than ${yearWords[years] ?? years} years of experience designing identity solutions for large organisations: authentication, federation, authorization and identity governance on the leading platforms.`,
  cv: 'See my CV',
  contact: 'Get in touch',
  mapTitle: 'What I design',
  mapLead: 'An identity architecture has a few moving parts. Pick one to see my work on it.',
  areasTitle: 'And around it',
  toolsTitle: 'Try it yourself',
  toolsLead: 'Demos and tools that run in your browser.',
  certsTitle: 'Certifications',
};

const parts = [
  {
    key: 'person',
    name: 'People',
    text: 'How people sign in: single sign-on, multi-factor authentication and passkeys, so access is safer and needs fewer passwords.',
    tags: ['SSO', 'MFA', 'Passkeys (FIDO2)'],
  },
  {
    key: 'app',
    name: 'Applications',
    text: 'How each application trusts the identity provider: federation with SAML and OIDC, and what every application is told about the user.',
    tags: ['SAML 2.0', 'OpenID Connect'],
  },
  {
    key: 'idp',
    name: 'Identity provider',
    text: 'The centre of the design and my main area of work. I compare and select the platform, define the target architecture, the authentication flows, the federation with applications and other providers and the session model, and build custom extensions when the product falls short.',
    tags: ['Keycloak', 'Ping Identity', 'Microsoft Entra ID', 'Okta', 'Transmit Security', 'and more'],
  },
  {
    key: 'dir',
    name: 'Directories',
    text: 'Where accounts live: user migrations and keeping identities in sync between HR, directories and applications, with SCIM where the application supports it.',
    tags: ['Active Directory', 'Microsoft Entra ID', 'OpenDJ', 'LDAP', 'SCIM 2.0'],
  },
  {
    key: 'api',
    name: 'APIs and services',
    text: 'How services call each other safely: authentication and authorization models with OAuth 2.0 and OIDC for APIs and microservices, with a Zero Trust approach.',
    tags: ['OAuth 2.0', 'OIDC'],
  },
  {
    key: 'authz',
    name: 'Access control',
    text: 'Who can do what, and under which conditions. I design access models based on roles (RBAC), attributes (ABAC) or policies (PBAC), depending on what each case needs, from the role catalogue to fine-grained authorization decisions.',
    tags: ['RBAC', 'ABAC', 'PBAC', 'PingAuthorize', 'Open Policy Agent (OPA)', 'Keycloak Authorization Services', 'and more'],
  },
  {
    key: 'gov',
    name: 'Governance',
    text: 'Who should have access to what, and for how long: joiner, mover and leaver processes and provisioning policies.',
    tags: ['Saviynt', 'PingIDM'],
  },
];
const selected = 'idp';

const links = [
  { area: 'l1', label: 'signs in' },
  { area: 'l2', label: 'OIDC / SAML' },
  { area: 'l3', label: 'accounts' },
  { area: 'v1', label: 'OAuth 2.0', dir: 'down' },
  { area: 'l4', label: 'checks access' },
  { area: 'v3', label: 'policies', dir: 'down' },
  { area: 'v2', label: 'lifecycle', dir: 'up' },
];

const areas = [
  [
    'IAM architecture and strategy',
    'Current and target state analysis (AS-IS / TO-BE), solution benchmarking and selection, and definition of the architecture and the deployment strategy.',
  ],
  [
    'Maturity and security reviews',
    'Assessment of access management deployments already in production to identify vulnerabilities and improvements.',
  ],
  [
    'Non-human and decentralized identity',
    'Knowledge of non-human identity (NHI) management, with the NHI Foundation Level certification, and of decentralized identifiers (DIDs).',
  ],
  [
    'Custom extensions',
    'Building what the product does not cover: Keycloak SPIs and PingAM and PingIDM nodes and scripts in Java and Groovy.',
  ],
];

const tools = (await getCollection('projects', (e) => e.data.featured && !e.data.draft && e.data.demo)).sort(
  (a, b) => a.id.localeCompare(b.id),
);
---

<Base page="home" description={t.description}>
  <section class="hero">
    <div class="hero-text">
      {
        photo && (
          <Image class="portrait" src={photo} alt={site.name} width={256} height={256} fit="cover" loading="eager" />
        )
      }
      <h1>{t.h1}</h1>
      <p>{t.lead}</p>
      <div class="actions">
        <a class="btn" href={routes.cv}>{t.cv}</a>
        <a class="btn quiet" href={routes.contact}>{t.contact}</a>
      </div>
    </div>
    <Token />
  </section>

  <section class="section">
    <header class="section-head">
      <h2>{t.mapTitle}</h2>
      <p>{t.mapLead}</p>
    </header>
    <div class="map">
      <div class="map-grid">
        {
          parts.map((part) => (
            <button
              class:list={['map-node', part.key === selected && 'core']}
              type="button"
              style={`grid-area: ${part.key}`}
              data-key={part.key}
              aria-pressed={part.key === selected ? 'true' : 'false'}
            >
              {part.name}
            </button>
          ))
        }
        {
          links.map((link) => (
            <span class:list={['map-link', link.dir]} style={`grid-area: ${link.area}`} aria-hidden="true">
              <span>{link.label}</span>
            </span>
          ))
        }
      </div>
      <div class="map-detail" aria-live="polite">
        {
          parts.map((part) => (
            <div data-detail={part.key} hidden={part.key !== selected}>
              <h3>{part.name}</h3>
              <p>{part.text}</p>
              <ul class="tags">
                {part.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <h2>{t.areasTitle}</h2>
    <ul class="areas">
      {
        areas.map(([title, text]) => (
          <li>
            <h3>{title}</h3>
            <p>{text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  {
    tools.length > 0 && (
      <section class="section">
        <header class="section-head">
          <h2>{t.toolsTitle}</h2>
          <p>{t.toolsLead}</p>
        </header>
        <ul class="rows">
          {tools.map((tool) => (
            <li>
              <a class="row" href={new URL(tool.data.demo!).pathname}>
                <span class="cat">{categoryLabels[tool.data.category]}</span>
                <h3>{tool.data.title}</h3>
                <svg class="go" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" /></svg>
                <p>{tool.data.summary}</p>
              </a>
              <Preview id={tool.id} />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="section">
    <h2>{t.certsTitle}</h2>
    <ul class="certs">
      {
        certifications.map((c) => (
          <li>
            <img class="logo" src={`/logos/${c.logo}`} alt="" width="44" height="44" loading="lazy" />
            <div>
              <strong>{c.name}</strong>
              <span>{c.issuer}</span>
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<script>
  const nodes = document.querySelectorAll<HTMLButtonElement>('.map-node');
  const details = document.querySelectorAll<HTMLElement>('[data-detail]');
  nodes.forEach((node) =>
    node.addEventListener('click', () => {
      nodes.forEach((other) => other.setAttribute('aria-pressed', String(other === node)));
      details.forEach((detail) => (detail.hidden = detail.dataset.detail !== node.dataset.key));
    }),
  );
</script>
