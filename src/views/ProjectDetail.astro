---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectNav from '../components/ProjectNav.astro';
import { routes } from '../data/nav';
import { categoryLabels } from '../data/categories';

interface Props {
  entry: CollectionEntry<'projects'>;
}
const { entry } = Astro.props;
const { Content } = await render(entry);

const t = {
  back: 'All projects',
  repo: 'Code',
  demo: 'Live demo',
  inDevelopment: 'In development: this project still has to be validated against the real product. Treat its results with care.',
};

---

<Base page="projects" title={entry.data.title} description={entry.data.summary}>
  <header class="page-head">
    <p><a href={routes.projects}>{t.back}</a></p>
    <h1>{entry.data.title}</h1>
    {entry.data.inDevelopment && <p class="notice">{t.inDevelopment}</p>}
    <p>{entry.data.summary}</p>
    <ul class="tags">
      <li>{categoryLabels[entry.data.category]}</li>
      {entry.data.tags.map((tag) => <li>{tag}</li>)}
    </ul>
    {
      (entry.data.repo || entry.data.demo) && (
        <div class="actions">
          {entry.data.demo && <a class="btn" href={entry.data.demo}>{t.demo}</a>}
          {entry.data.repo && <a class="btn quiet" href={entry.data.repo}>{t.repo}</a>}
        </div>
      )
    }
  </header>
  <div class="prose">
    <Content />
  </div>
  <ProjectNav current={entry.id} />
</Base>
